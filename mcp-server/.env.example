# Copy to .env.local for local dev. On Vercel, set these as real Environment
# Variables in Project Settings instead (never commit real values).

# base64-encoded Firebase service account JSON (Firebase console -> Project
# settings -> Service accounts -> Generate new private key), e.g.:
#   base64 -i service-account.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT=

# Any long random string. Claude's connector setup will need this exact
# value as the bearer token, e.g.:
#   openssl rand -hex 32
MCP_AUTH_TOKEN=
